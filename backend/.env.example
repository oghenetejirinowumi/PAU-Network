# Neon pooled connection (hostname contains -pooler) used by the running app
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon direct connection used by Prisma CLI (migrations)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional. Use 1 for the local `prisma dev` server; leave unset for Neon.
# DATABASE_POOL_MAX=10

PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
# Create an app in the LinkedIn Developer Portal and enable "Sign In with LinkedIn using OpenID Connect".
# LINKEDIN_CLIENT_ID="your-client-id"
# LINKEDIN_CLIENT_SECRET="your-client-secret"
# Register this exact URL as the app's authorized redirect URL.
LINKEDIN_REDIRECT_URI="http://localhost:4000/api/v1/auth/linkedin/callback"
# Resend sender address must be verified in your Resend account.
# RESEND_API_KEY="re_your_api_key"
# EMAIL_FROM="reminders@your-verified-domain.com"
# Create a LiveKit Cloud project for audio-only Spaces.
# LIVEKIT_URL="wss://your-project.livekit.cloud"
# LIVEKIT_API_KEY="your-livekit-api-key"
# LIVEKIT_API_SECRET="your-livekit-api-secret"
